VOICE_HOST=0.0.0.0
VOICE_PORT=8090
VOICE_EAGER_LOAD=true

NODE_BASE_URL=http://localhost:8080
NODE_API_KEY=
# Même valeur que TWILIO_AUTH_TOKEN Fastify : signe le streamToken media-stream.
TWILIO_AUTH_TOKEN=

# vLLM local OpenAI-compatible. VLLM_MODEL doit matcher EXACTEMENT
# GET http://localhost:8000/v1/models  — pas un alias.
# Exemple courant Hugging Face :
#   VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# llama-3.1-8b-instruct est souvent Faux si vLLM a charge le depot HF.
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=

# Scaleway topologie B : vLLM reste interne au Docker du nœud GPU.
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=restaurant-assistant
# VLLM_API_KEY=<secret-dedie-vllm>

# Token Hugging Face pour telecharger un modele gated (licence Llama).
# Ce n'est PAS un compte vLLM : vLLM tourne en local une fois les poids la.
HF_TOKEN=

# Test fonctionnel CPU (plus lent). Sur GPU :
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16
STT_PROVIDER=faster-whisper
TTS_PROVIDER=kokoro
VAD_PROVIDER=silero
TURN_DETECTOR=heuristic
# native = seul orchestrateur Twilio/FastAPI supporte (pipecat evalue puis abandonne,
# retire du code le 2026-09-22). Le chemin production reste livekit_agent/ (LiveKit Agents).
VOICE_ORCHESTRATOR=native
AUDIO_PREPROCESS=agc
WHISPER_BEAM_SIZE=5
LLM_STREAM=true
TTS_STREAM=true
TTS_CHUNKING=sentence
TURN_INCOMPLETE_WAIT_MS=800
BARGE_IN_ENABLED=true
# Candidat 160 ms (bande 120-200). Pas un optimum prouve. 50 ms de bruit ne doit pas clear.
BARGE_IN_CONFIRM_MS=160
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

KOKORO_VOICE=ff_siwis
KOKORO_LANG=fr-fr
KOKORO_SPEED=1.0
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=

VAD_THRESHOLD=0.35
VAD_SILENCE_MS=550
VAD_MIN_SPEECH_MS=180
VAD_MODEL_PATH=

GREETING_TEXT=Bonjour, je vous ecoute.
CACHE_DIR=

# Fallback LLM si vLLM est down (Chat Completions). Laisser vide = pas de fallback LLM.
# Fastify peut quand meme basculer l appel entier vers OpenAI Realtime.
LLM_FALLBACK_GPT=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- LiveKit Agents (package isolé livekit_agent/, fallback Twilio inchangé) ---
# LIVEKIT_URL pointe vers le LiveKit Server de la VM CPU, pas vers le GPU.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=restaurant-voice
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
VOICE_TOOLS_ENABLED=true
VOICE_TOOLS_PROFILE=full
RESTAURANT_ID=
RESTAURANT_NAME=
SIP_DID_TENANT_MAP=
# Defaut LiveKit = 1.2 via LIVEKIT_KOKORO_SPEED, independant de KOKORO_SPEED=1.0 legacy.
LIVEKIT_KOKORO_SPEED=1.2
