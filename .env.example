VOICE_HOST=0.0.0.0
VOICE_PORT=8090
VOICE_EAGER_LOAD=true

NODE_BASE_URL=http://localhost:8080
NODE_API_KEY=

# vLLM local OpenAI-compatible. VLLM_MODEL doit matcher EXACTEMENT
# GET http://localhost:8000/v1/models  — pas un alias.
# Exemple courant Hugging Face :
#   VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# llama-3.1-8b-instruct est souvent Faux si vLLM a charge le depot HF.
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=

# Scaleway topologie B : vLLM reste interne au Docker du nœud GPU.
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=restaurant-assistant
# VLLM_API_KEY=<secret-dedie-vllm>

# Token Hugging Face pour telecharger un modele gated (licence Llama).
# Ce n'est PAS un compte vLLM : vLLM tourne en local une fois les poids la.
HF_TOKEN=

# Test fonctionnel CPU (plus lent). Sur GPU :
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

KOKORO_VOICE=ff_siwis
KOKORO_LANG=fr-fr
KOKORO_SPEED=1.2
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=

VAD_THRESHOLD=0.5
VAD_SILENCE_MS=400
VAD_MIN_SPEECH_MS=250
VAD_MODEL_PATH=

GREETING_TEXT=Bonjour, je vous ecoute.
CACHE_DIR=

# Fallback LLM si vLLM est down (Chat Completions). Laisser vide = pas de fallback LLM.
# Fastify peut quand meme basculer l appel entier vers OpenAI Realtime.
LLM_FALLBACK_GPT=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
