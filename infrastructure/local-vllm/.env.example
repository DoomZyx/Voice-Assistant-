# Valeurs adaptées à un premier test sur un GPU NVIDIA disposant d'au moins 8 Go de VRAM.
VLLM_IMAGE=vllm/vllm-openai:v0.10.2
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_SERVED_MODEL_NAME=restaurant-assistant
VLLM_TOOL_CALL_PARSER=hermes
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=4
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_PORT=8000

# Requis uniquement pour un modèle Hugging Face privé ou soumis à acceptation.
HF_TOKEN=
